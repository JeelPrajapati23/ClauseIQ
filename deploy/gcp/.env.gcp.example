# Copy this file to deploy/gcp/.env.gcp (gitignored) and fill in real values.
# Never put real secrets in bootstrap.sh itself — it's tracked by git.
#
# Quote every value in single quotes, with the closing quote immediately after
# the value — no trailing spaces before it, they'd become part of the value
# and break things downstream (e.g. a padded DATABASE_URL fails to connect).
# This file gets `source`d by bash, and connection strings/tokens often
# contain characters bash treats specially if left unquoted — e.g. Neon URLs
# contain "&", which bash reads as "run this assignment in the background"
# and silently discards it instead of setting the variable.

# Your GCP project ID (not the project *name* — check `gcloud projects list`
# or the console). Must already exist with billing enabled; project creation
# and billing-account linking still need the web console the first time.
PROJECT_ID=''
# Region for Artifact Registry + Cloud Run. us-central1 has the broadest free
# tier resource availability; change if your Neon/Qdrant Cloud instances are
# in a specific region and you want to minimize latency instead.
REGION='us-central1'

GROQ_API_KEY=''
COHERE_API_KEY=''
# HF token for the embedding model (app/database.py calls BAAI/bge-base-en-v1.5
# via HF's hosted Inference API instead of loading it in-process). Free-tier
# token is fine — create one at https://huggingface.co/settings/tokens.
HUGGINGFACEHUB_API_TOKEN=''
JWT_SECRET_KEY=''
# Neon connection string, e.g. 'postgresql://user:pass@host/db?sslmode=require&channel_binding=require'
DATABASE_URL=''
# Qdrant Cloud cluster URL, e.g. 'https://xxxx.aws.cloud.qdrant.io'
QDRANT_URL=''
QDRANT_API_KEY=''
# your Vercel URL, e.g. 'https://clauseiq-rag.vercel.app'
APP_FRONTEND_URL=''

# Optional — leave all five blank to have password-reset links printed to the
# Cloud Run service's logs instead of emailed (same fallback as local dev).
SMTP_HOST=''
SMTP_PORT='587'
SMTP_USER=''
SMTP_PASS=''
FROM_EMAIL=''

# Optional — LangSmith tracing. Leave LANGCHAIN_TRACING_V2 blank/unset to keep
# it off (same silently-off fallback as local dev, see app/generator.py).
LANGCHAIN_TRACING_V2=''
LANGCHAIN_API_KEY=''
LANGCHAIN_PROJECT='clauseiq-rag'
